# TTI Merkezi Veri — yönetim paneli imajı (React SPA, nginx ile servis edilir).
#
# ÇOK AŞAMALI: build aşaması Node'u taşır ve `dist/` üretir; runtime aşaması yalnızca nginx'i
# taşır. Bağlam (context) depo KÖKÜDÜR — tek .dockerignore iki imajı da yönetsin diye.

# ---- 1) build aşaması ----------------------------------------------------------------------
FROM node:22-alpine AS build
WORKDIR /derleme

COPY admin-panel/package.json admin-panel/package-lock.json ./
RUN npm ci

COPY admin-panel/ ./

# ⚠️ VITE_API_BASE_URL build-arg'ı KASITLI OLARAK YOK.
# Panel, API'ye GÖRELİ yolla gider (src/api/client.ts). Üretimde panel ve API aynı origin'den
# servis ediliyor (data.<DOMAIN>; Caddy yola göre ayırıyor), dolayısıyla:
#   · imaja gömülü bir IP/hostname kalmıyor — adres değişince imaj yeniden derlenmesi gerekmiyor,
#   · CORS tamamen ortadan kalkıyor.
RUN npm run build

# ---- 2) runtime aşaması --------------------------------------------------------------------
FROM nginx:1.27-alpine

COPY deploy/nginx.conf /etc/nginx/nginx.conf
COPY --from=build --chown=1000:1000 /derleme/dist /usr/share/nginx/html

# Kök olmayan kullanıcı (YENI-PROJE.md §6). Resmî nginx entrypoint'i 1.21'den beri kök olmayan
# çalıştırmayı algılayıp kök gerektiren adımlarını uyarıyla atlar — ENTRYPOINT override'ı gerekmez.
USER 1000:1000

EXPOSE 8080
