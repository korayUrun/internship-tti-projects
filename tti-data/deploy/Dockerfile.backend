# TTI Merkezi Veri — backend imajı. ÇOK AŞAMALI (multi-stage): derleme imajın İÇİNDE yapılır.
#
# build aşaması derleyiciyi (gcc/libpq-dev) taşır ve bağımlılıkları bir venv'e kurar; runtime
# aşaması yalnızca o venv'i kopyalar. Böylece ne dev'de ne sunucuda derleyici kurulur, çalışan
# imaj küçük kalır ve elle bir build adımı olmaz — `docker compose build` her şeyi yapar.
#
# ⚠️ build aşaması PyPI'dan bağımlılık çeker (build anı internet gerekir). Kapalı ağda build'i
#    dev makinesinde koşup imajı `docker save`/`load` ile taşıyın — Dockerfile aynı kalır.
#
# Bağlam (context) depo KÖKÜDÜR, backend/ değil: tek .dockerignore iki imajı da yönetsin ve
# aşağıdaki `COPY deploy/giris.sh` çalışsın diye.

# ---- 1) build aşaması ----------------------------------------------------------------------
FROM python:3.12-slim AS build

# gcc/libpq-dev: bağımlılıkların çoğu manylinux wheel'i ile geliyor, yani büyük ihtimalle hiçbir
# şey derlenmeyecek. Yine de sigorta olarak duruyorlar ve BUILD aşamasında kaldıkları için
# çalışan imaja tek bayt maliyetleri yok.
RUN apt-get update \
 && apt-get install -y --no-install-recommends gcc libpq-dev \
 && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /tmp/requirements.txt
RUN python -m venv /opt/venv \
 && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
 && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements.txt

# ---- 2) runtime aşaması --------------------------------------------------------------------
FROM python:3.12-slim

# curl, YALNIZCA sağlık kontrolü için. `python:3.12-slim`de ne curl ne de wget vardır: bu satır
# olmadan compose'daki healthcheck her seferinde başarısız olur, konteyner sonsuza kadar
# "unhealthy" görünür ve ona `depends_on` ile bağlı her servis takılır — uygulama sorunsuz
# çalışırken.
RUN apt-get update \
 && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/*

COPY --from=build /opt/venv /opt/venv

ENV PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    YUKLEME_KOK=/yukleme \
    TZ=Europe/Istanbul

# Uygulama kök yetkisiyle çalışmaz (YENI-PROJE.md §6). Sayısal UID/GID: 1000, Linux'ta ilk
# kullanıcının kimliğiyle örtüştüğü için bind mount edilen /yukleme genellikle doğrudan
# yazılabilir olur.
RUN mkdir -p /uygulama /yukleme && chown -R 1000:1000 /uygulama /yukleme

WORKDIR /uygulama
COPY --chown=1000:1000 backend/ /uygulama/
COPY --chown=1000:1000 deploy/giris.sh /uygulama/giris.sh

USER 1000:1000

EXPOSE 8000

# `sh <betik>`: zip → scp → unzip yolculuğunda dosyanın çalıştırma bitine güvenmiyoruz.
ENTRYPOINT ["sh", "/uygulama/giris.sh"]
