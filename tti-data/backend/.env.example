# Bu dosya BİR REFERANSTIR — uygulama tarafından OKUNMAZ.
#
# `app/config.py` bilerek `env_file` kullanmaz: imaja sızmış eski bir `.env`, compose'un
# `environment:` bloğunu sessizce ezer ve uygulama yanlış veritabanına bağlanır. Değerlerin
# gerçek kaynağı:
#   · üretim    : tti-sunucu/docker-compose.yml  (değerler tti-sunucu/.env'den)
#   · geliştirme: tti-data/deploy/docker-compose.yml
#
# Aşağıdaki liste, eksik olduğunda uygulamanın AÇILMAYACAĞI değişkenleri gösterir.

# --- ZORUNLU (varsayılanı yok; eksikse uygulama açılışta durur) ---------------------------
# Ayrıcalıksız `data` rolü ile paylaşımlı tti-db'deki `data` veritabanına.
# ⚠️ `tti` ya da `rapor` veritabanına ASLA bağlanılmaz — onlar başka projelerin.
DATABASE_URL=postgresql+psycopg://data:<parola>@db:5432/data
# Tüm tablolar ve alembic_version bu şemaya düşer. Testlerde boş bırakılır (SQLite şema tanımaz).
DB_SCHEMA=data
JWT_SECRET_KEY=<openssl rand -base64 48>
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<güçlü parola>
# Konteyner içi yol TAM OLARAK /yukleme olmalı: yedek.sh host yolunu bu bağlamadan bulur.
YUKLEME_KOK=/yukleme
# /api/saglik bunu döner; dogrula.sh okur. Tarih etiketi, asla `dev`/`latest` değil.
SURUM=2026-08-19

# --- İSTEĞE BAĞLI (davranış ayarı, varsayılanı var) ---------------------------------------
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
ROW_COUNT_DROP_WARNING_RATIO=0.5
# ⚠️ Havuz tavanı = pool_size + max_overflow = 10 ve SÜREÇ BAŞINADIR (--workers 1).
# Bu sayı tti-sunucu/.env.example'daki bütçe tablosuna beyan edilmiştir; değiştirmeden önce
# YENI-PROJE.md §6'ya bakın — aşılırsa DİĞER projeler "too many clients" ile düşer.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Panel aynı origin'den servis edildiği için üretimde BOŞ. Boşken middleware hiç eklenmez.
CORS_ALLOWED_ORIGINS=
