# =============================================================
#  tti-projeler — kök .gitignore
#  Alt projeler (tti-data, tti-hakedis, tti-rapor, tti-sunucu)
#  kendi .gitignore'larını korur; bu dosya hepsi için ortak
#  kuralları toplar.
# =============================================================

# ---------- İşletim sistemi / editör ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini
.idea/
.vscode/
*.iml
*.swp
*~

# ---------- Sırlar (ASLA depoya girmez) ----------
.env
.env.*
!.env.example
.env.oncesi-*
*.pem
*.key
*.crt
*.cer
*.der
*.pfx
*.p12
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
api_keys.txt
appsettings.Local.json
local.properties
certs/
secrets/

# ---------- Python (tti-data/backend) ----------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- Node / frontend (admin-panel, web) ----------
node_modules/
dist/
build/
.next/
.cache/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Kotlin / Gradle / Android (tti-hakedis) ----------
.gradle/
.kotlin/
captures/
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.aar
*.hprof

# ---------- .NET (tti-rapor) ----------
bin/
obj/
yayin/
*.user
*.suo

# ---------- Veritabanı kalıntıları ----------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ---------- Çalışma zamanı verisi / yüklemeler ----------
# Kullanıcı yüklemeleri, saha fotoğrafları, yedekler — kod değil, veri.
yukleme/
yerel-veri/
arsiv/
backups/
yedek-test/
deneme/
uploads/

# ---------- Loglar ve geçici dosyalar ----------
*.log
logs/
*.bak
*.tmp
tmp/

# ---------- Derleme çıktıları / büyük ikili dosyalar ----------
*.jar
*.war
!gradle/wrapper/gradle-wrapper.jar
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.dump
*.sql.gz

# ---------- Kök dizindeki ekran görüntüleri ----------
/Screenshot*.png
