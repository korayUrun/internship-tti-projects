# Bu dosyayı `.env` olarak kopyalayıp doldurun. `.env` depoya GİRMEZ (parola içerir).
#   cp .env.example .env && chmod 600 .env

# --- Sürümler -----------------------------------------------------------------------------
# Şema: YYYY-AA-GG (aynı gün ikinci sürüm için .2). Değişmez etiket: bir kez üretilip kurulan
# etiketin içeriği bir daha DEĞİŞMEZ — geri dönüşün tek dayanağı budur.
#
# GERİ DÖNÜŞ: aşağıdaki değeri bir önceki tarihe çevirin, `docker compose up -d`. ~20 saniye.
# `dev` ya da `latest` BURAYA YAZILMAZ; onlar hareketli işaretçidir ve üstüne yazılır.
SURUM=2026-08-11
SURUM_RAPOR=2026-08-11
SURUM_DATA=2026-08-19

# --- Paylaşılan veritabanı ----------------------------------------------------------------
# Tek PostgreSQL örneği, proje başına AYRI VERİTABANI ve ayrı rol.
# Projeler arası sorgu PostgreSQL'in dilinde yoktur — sınır yapısaldır, disipline bağlı değil.
DB_ADI=tti

# BAKIM (superuser) hesabı: veritabanını bootstrap eder (POSTGRES_USER), provizyon/yedek/elle psql
# bununla koşar. ⚠️ UYGULAMALAR bununla BAĞLANMAZ — superuser tüm yetki sınırlarını atlar ve bir
# proje diğerinin verisini okuyabilir hâle gelir (hiçbir hata vermeden).
DB_BAKIM_KULLANICI=tti_hakedis
DB_BAKIM_PAROLA=degistir-beni

# TTI UYGULAMA rolü — AYRICALIKSIZ. `provizyon/01-tti.sql` bu rolü bu parolayla oluşturur; iki değer
# AYNI olmalı, yoksa uygulama bağlanamaz. (Rapor'un kendi rolü `rapor` ayrı — RAPOR_DB_PAROLA.)
DB_KULLANICI=tti_uygulama
DB_PAROLA=degistir-beni

# Volume adı. İlk kurulumda:  docker volume create tti_db_verisi
# Var olan bir kurulumdan geçiyorsanız eski adı yazın (ör. deploy_tti_db_verisi) — yoksa
# Docker boş bir volume yaratır ve veri KAYBOLMUŞ GÖRÜNÜR.
DB_VOLUME=tti_db_verisi

# --- Reverse proxy (domain adları) --------------------------------------------------------
# Kullanıcılar IP:port değil domain yazar: http://hakedis.<DOMAIN> ve http://rapor.<DOMAIN>.
# Caddy (proxy servisi) gelen Host'a göre doğru konteynere yönlendirir.
# ⚠️ İsmi IP'ye çözmek Docker'ın işi DEĞİL: kurumsal DNS'e A kaydı ekletin (IT):
#       hakedis.<DOMAIN>  A  <sunucu-ip>
#       rapor.<DOMAIN>    A  <sunucu-ip>
DOMAIN=tti.local

# --- Proje 1: TTI Saha Hakediş ------------------------------------------------------------
TTI_PORT=8081
# Üretilen PDF/Excel aynası — yeniden üretilebilir.
TTI_ARSIV_KOK=/srv/veri/tti-hakedis/arsiv
# Kullanıcının yüklediği EK1/EK2 — ASIL VERİ, kaybı geri alınamaz.
TTI_YUKLEME_KOK=/srv/veri/tti-hakedis/yukleme

# --- Proje 2: TTIDataRapor ----------------------------------------------------------------
RAPOR_PORT=8082
RAPOR_DB_ADI=rapor
RAPOR_DB_PAROLA=degistir-beni
# Saha fotoğrafları — ASIL VERİ, kaybı geri alınamaz.
RAPOR_YUKLEME_KOK=/srv/veri/tti-rapor/yukleme

# --- Proje 3: TTI Merkezi Veri Yönetim Sistemi --------------------------------------------
DATA_PORT=8083
DATA_PANEL_PORT=8084
DATA_DB_ADI=data
# ⚠️ provizyon/03-data.sql'deki parolayla AYNI olmalı, yoksa uygulama bağlanamaz.
DATA_DB_PAROLA=degistir-beni
# openssl rand -base64 48
DATA_JWT_ANAHTARI=degistir-beni
DATA_ADMIN_KULLANICI=admin
DATA_ADMIN_PAROLA=degistir-beni
# Yüklenen Excel'ler + rollback JSON anlık görüntüleri — ASIL VERİ, kaybı geri alınamaz.
# (dataset_records yalnızca AKTİF sürümü tutar; JSON'lar her önceki sürümün tek kopyasıdır.)
DATA_YUKLEME_KOK=/srv/veri/tti-data/yukleme

# --- Havuz bütçesi (bilgi) ----------------------------------------------------------------
# max_connections=50 (docker-compose.yml), 3'ü superuser'a ayrılmış → 47 kullanılabilir.
#
#   TTI    (Hikari)      10   application.yml → maximum-pool-size
#   Rapor  (Npgsql)      10   bağlantı dizesi → Maximum Pool Size
#   Data   (SQLAlchemy)  10   backend/app/database.py → pool_size 5 + max_overflow 5
#   yedek/bakım           5
#   ----------------------------
#   toplam               35   → 12 boşluk, yani ~1 proje daha
#
# Yeni proje eklerken bu tabloyu güncelleyin. Bir servis havuzunu sınırsız bırakırsa bütçeyi
# tek başına tüketir ve DİĞER projeler "sorry, too many clients" ile düşer.
